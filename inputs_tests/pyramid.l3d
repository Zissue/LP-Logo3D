// draw a pyramid
// This program creates a 3D pyramid structure

PROC triangle(size) IS
    FOR i FROM 1 TO 3 DO
        forward(size)
        left(120)
    END
END

PROC pyramid(levels) IS
    IF levels > 0 THEN
        triangle(levels * 2)
        up(30)
        forward(1)
        down(30)
        pyramid(levels - 1)
    END
END

PROC main() IS
    color(1.0, 0.8, 0.2)  // Golden color
    pyramid(8)
END
